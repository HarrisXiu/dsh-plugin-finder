{
  "name": "dsh-plugin-finder",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Discover all public GitHub repositories tagged dsh-plugin, with domestic mirror fallback and resumable scans.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node tools/build-data.mjs",
    "test": "node tools/selfcheck.mjs && node tools/preinstall.mjs && node tools/clientcheck.mjs",
    "test:live": "node tools/livecheck.mjs"
  }
}
